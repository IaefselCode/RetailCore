# --- Database ---
# Pooler URL — used at runtime by the app (through PgBouncer / Supabase pooler).
DATABASE_URL = "postgresql://postgres:12345@localhost:6543/retailCore"
# Direct URL — used by Prisma CLI for migrations, db push, and DDL.
# Must bypass the connection pooler (direct port 5432).
DIRECT_URL    = "postgresql://postgres:12345@localhost:5432/retailCore"

# --- Auth.js (NextAuth) - used to sign JWT session cookies ---
# Generate a new one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me

# NextAuth URL (set in production - also enables trustHost outside of dev)
# AUTH_URL=https://your-app.vercel.app

# --- Resend - transactional email (password reset links) ---
# Get your key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=RetailCore <onboarding@resend.dev>

# --- Image storage ---
# Where uploaded images (product photos, avatars) are stored.
#
#   local    (default) - saves to public/uploads/<folder>/<uuid>.webp and serves
#                        them at /uploads/<folder>/<uuid>.webp. Zero config, ideal
#                        for local development.
#   supabase - uploads to Supabase Storage (needs SUPABASE_URL +
#                        SUPABASE_SERVICE_ROLE_KEY below).
#
# To move to hosting, flip the provider and fill in the Supabase vars:
#   STORAGE_PROVIDER=supabase
STORAGE_PROVIDER=local

# Supabase Storage (only used when STORAGE_PROVIDER=supabase)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- Supabase client (browser + server) ---
# Anon/publishable key is safe to expose client-side.
# https://supabase.com/dashboard/project/<project-ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
